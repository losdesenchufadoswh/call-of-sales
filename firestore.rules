rules_version = '2';

// Reglas de Call of Sales.
// Idea: hay que estar autenticado para todo. Cada vendedor solo toca lo suyo;
// el admin (el_fe) ve y edita lo de cualquiera.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    // El id de operador sale del correo: elfe@call-of-sales.com -> "elfe"
    function miId() {
      return request.auth.token.email.split('@')[0];
    }

    function soyAdmin() {
      return autenticado() && miId() == 'elfe';
    }

    function esMio(doc) {
      return autenticado() && doc.owner == miId();
    }

    match /ventas/{ventaId} {
      // leer: el admin todo, el vendedor solo sus cierres
      allow read: if soyAdmin() || esMio(resource.data);

      // crear: el vendedor solo puede crear a su nombre; el admin a nombre de cualquiera
      allow create: if soyAdmin() || esMio(request.resource.data);

      // editar/borrar: el admin cualquiera; el vendedor solo los suyos, y no
      // puede pasarle el cierre a otro
      allow update: if soyAdmin() || (esMio(resource.data) && esMio(request.resource.data));
      allow delete: if soyAdmin() || esMio(resource.data);
    }

    // Marcador del escuadron: SOLO numeros (puntos, internet, celulares, voice).
    // Todos lo leen para ver el ranking; cada quien publica el suyo y el admin
    // puede publicar el de cualquiera. Aqui nunca van datos de cliente.
    match /ranking/{docId} {
      allow read: if autenticado();
      allow write: if soyAdmin() || (autenticado() && request.resource.data.owner == miId());
    }

    // Medallas entre companeros (boom headshot, no scope, ace, flex).
    // Solo ids de operador y el tipo: aqui tampoco van datos de cliente, por eso
    // las lee todo el escuadron y se ven los contadores de cada quien.
    match /medallas/{docId} {
      allow read:   if autenticado();
      // solo puedes mandarlas a tu nombre, y no a ti mismo
      allow create: if autenticado()
                    && request.resource.data.de == miId()
                    && request.resource.data.para != miId()
                    && request.resource.data.vista == false;
      // el que la recibe solo puede marcarla como vista; nada mas se toca
      allow update: if autenticado()
                    && resource.data.para == miId()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vista']);
      allow delete: if soyAdmin();
    }

    // Logros ganados vendiendo (hardline, nuclear, overwatch...). Son historicos
    // y publicos dentro del escuadron: solo owner, tipo y periodo, sin clientes.
    // El id es `owner-tipo-periodo`, por eso rehacer el calculo nunca duplica.
    match /logros/{docId} {
      allow read:   if autenticado();
      // los tuyos, o cualquiera si eres el admin (que tiene todas las ventas)
      allow create: if soyAdmin() || esMio(request.resource.data);
      // marcar visto es lo unico que se toca despues
      allow update: if (soyAdmin() || esMio(resource.data))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visto']);
      allow delete: if soyAdmin();
    }

    // Lo que cada quien se puso del pase: fondo, titulo, emote, marco y color.
    // Son cinco textos. Todos lo leen porque los cosmeticos se ven en el
    // ranking, pero solo puedes escribir el tuyo (el id del doc es tu id).
    match /look/{uid} {
      allow read:  if autenticado();
      allow write: if soyAdmin() || (autenticado() && uid == miId());
    }

    // Agenda de instaladores: nombre, telefono y zona de los tecnicos.
    // Es del escuadron entero —un buen instalador le sirve a todos— asi que
    // cualquiera la lee y la edita. Borrar tambien, que si alguien deja de
    // trabajar hay que poder quitarlo sin esperar al admin.
    match /instaladores/{docId} {
      allow read, write: if autenticado();
    }

    // Marca de la carga inicial de julio. Solo el admin la escribe.
    match /meta/{docId} {
      allow read:  if autenticado();
      allow write: if soyAdmin();
    }

    // Perfiles: cada quien lee el escuadron, pero solo el admin escribe roles
    match /users/{userId} {
      allow read:  if autenticado();
      allow write: if soyAdmin();
    }

    // Chat del escuadron: todos leen y escriben, pero solo a su nombre
    match /chat/{msgId} {
      allow read:   if autenticado();
      allow create: if autenticado() && request.resource.data.u == miId();
      allow update, delete: if soyAdmin();
    }

    // Todo lo demas queda cerrado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
